# Track only Martfury child + custom TMT plugins (tmt-*).
# Parent theme martfury stays local / on the server, not in Git.
*

!.gitignore
!.gitattributes
!.cpanel.yml
!.github/
!.github/workflows/
!.github/workflows/**

!themes/
themes/*
!themes/martfury-child/
!themes/martfury-child/**

!plugins/
plugins/*
!plugins/tmt-*/
!plugins/tmt-*/**
